# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Hybrid semantic highlight analysis
# Local-first: install Ollama and pull a model, e.g. `ollama pull llama3.2`.
VYRO_LOCAL_LLM_ENABLED=true
VYRO_LOCAL_LLM_URL=http://127.0.0.1:11434/api/chat
VYRO_LOCAL_LLM_MODEL=llama3.2

# Local speech transcription. The tiny model downloads on first analysis.
VYRO_FASTER_WHISPER_MODEL=tiny

# Optional cloud fallback (OpenAI-compatible Chat Completions endpoint).
# Leave VYRO_LLM_API_KEY empty to keep analysis local-only.
VYRO_LLM_API_KEY=
VYRO_LLM_API_URL=https://api.openai.com/v1/chat/completions
VYRO_LLM_MODEL=gpt-4o-mini
